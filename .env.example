# ==============================================================================
# TEMİZ KURU TEMİZLEME - ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# ==============================================================================
# Bu dosyayı kopyalayarak .env dosyasını oluşturun:
#   cp .env.example .env
#
# DİKKAT: .env dosyasını ASLA git reposuna eklemeyin (.gitignore içinde olmalıdır).
# ==============================================================================

# 1. YÖNETİCİ GÜVENLİK ANAHTARI (ZORUNLU)
# Admin paneline giriş için kullanılan süper güvenli anahtar.
# Minimum 32 karakter uzunluğunda, tahmin edilemez karmaşık bir anahtar girin.
ADMIN_SECRET_KEY=degistirin_en_az_32_karakterli_guclu_yonetici_anahtari_2026

# 2. VERİTABANI BAĞLANTISI (OPSİYONEL / TAVSİYE EDİLEN SIFIR MALİYET)
# MongoDB Atlas M0 (Free Forever / Sıfır Ek Ücret) bağlantı dizesi.
# Girilmezse sistem tarayıcı yerel hafızasında (localStorage) güvenle çalışır.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/temizkurutemizleme?retryWrites=true&w=majority

# 3. ÇALIŞMA ORTAMI
NODE_ENV=production
